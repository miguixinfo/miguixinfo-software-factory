package {{ java_package }}.item.adapter.in.web;

import {{ java_package }}.item.domain.model.Item;
import {{ java_package }}.item.domain.port.in.CreateItemUseCase;
import {{ java_package }}.item.domain.port.in.ListItemsUseCase;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import jakarta.validation.Valid;
import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.Size;
import java.util.List;
import java.util.UUID;
import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.ResponseStatus;
import org.springframework.web.bind.annotation.RestController;

@RestController
@RequestMapping("/api/items")
@Tag(name = "Items", description = "Módulo de ejemplo de la plantilla")
public class ItemController {

    private final CreateItemUseCase createItem;
    private final ListItemsUseCase listItems;

    public ItemController(CreateItemUseCase createItem, ListItemsUseCase listItems) {
        this.createItem = createItem;
        this.listItems = listItems;
    }

    @GetMapping
    @Operation(summary = "Lista los items")
    public List<ItemResponse> list() {
        return listItems.list().stream().map(ItemResponse::from).toList();
    }

    @PostMapping
    @ResponseStatus(HttpStatus.CREATED)
    @Operation(summary = "Crea un item")
    public ItemResponse create(@Valid @RequestBody CreateItemRequest request) {
        return ItemResponse.from(createItem.create(request.name()));
    }

    public record CreateItemRequest(
            @NotBlank @Size(max = Item.MAX_NAME_LENGTH) String name) {}

    public record ItemResponse(UUID id, String name) {
        static ItemResponse from(Item item) {
            return new ItemResponse(item.id(), item.name());
        }
    }
}
