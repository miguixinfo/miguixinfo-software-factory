version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
{%- if has_backend %}
  - package-ecosystem: maven
    directory: /backend
    schedule:
      interval: weekly
    groups:
      maven-minor:
        update-types: [minor, patch]
{%- endif %}
{%- if has_frontend %}
  - package-ecosystem: npm
    directory: /frontend
    schedule:
      interval: weekly
    groups:
      npm-minor:
        update-types: [minor, patch]
{%- endif %}
  - package-ecosystem: docker
    directories:
{%- if has_backend %}
      - /backend
{%- endif %}
{%- if has_frontend %}
      - /frontend
{%- endif %}
    schedule:
      interval: weekly
