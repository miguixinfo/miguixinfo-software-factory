# Monitorización en el mismo VPS: Prometheus recoge las métricas de Actuator y Grafana las muestra.
# Grafana solo escucha en localhost; accede con un túnel SSH:  ssh -L 3000:localhost:3000 usuario@vps
# Arranque: docker compose --env-file ../.env up -d
name: {{ project_slug }}-monitoring

services:
  prometheus:
    image: prom/prometheus:latest
    restart: unless-stopped
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    networks: [app]

  grafana:
    image: grafana/grafana-oss:latest
    restart: unless-stopped
    environment:
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_PASSWORD:?falta GRAFANA_PASSWORD}
      GF_USERS_ALLOW_SIGN_UP: "false"
    ports:
      - "127.0.0.1:3000:3000"
    volumes:
      - grafana-data:/var/lib/grafana
    networks: [app]

volumes:
  prometheus-data:
  grafana-data:

networks:
  app:
    name: {{ project_slug }}_{% if has_backend %}internal{% else %}edge{% endif %}
    external: true
